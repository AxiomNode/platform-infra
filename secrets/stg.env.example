# platform-infra (stg)
# Copy to secrets/stg.env locally and fill with real values before sealing.
QUIZZ_DB_USER=quiz
QUIZZ_DB_PASSWORD=change-me-stg-quiz-password
QUIZZ_DB_NAME=quizdb
WORDPASS_DB_USER=wordpass
WORDPASS_DB_PASSWORD=change-me-stg-wordpass-password
WORDPASS_DB_NAME=wordpassdb
USERS_DB_USER=users
USERS_DB_PASSWORD=change-me-stg-users-password
USERS_DB_NAME=usersdb
# Optional: path to Firebase service account JSON for users service
FIREBASE_CREDENTIALS_FILE=
# Shared service-to-service token (header x-internal-token). Generate one random value
# per environment (e.g. openssl rand -hex 32); api-gateway, bff-backoffice and every
# service that calls /internal/* must receive the same value via their *-secret.
INTERNAL_SERVICE_TOKEN=change-me-stg-internal-service-token
# Reverse-proxy hops in front of api-gateway/bff-mobile/microservice-users: true|false|<hop count>|<CIDR list>.
# Must match the real topology or client IPs (rate limiting) are spoofable. See kubernetes/README.md.
TRUST_PROXY=false
DOCKER_REGISTRY=ghcr.io/axiomnode
DOCKER_IMAGE_TAG=stg-latest
COMPOSE_PROJECT_NAME=axiomnode-stg